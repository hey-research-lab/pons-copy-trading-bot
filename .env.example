# Public RPC — paper / smoke only. Rate-limited; not for live fills.
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Paid RPC for live trading. Alchemy is Robinhood's recommended provider:
# https://dashboard.alchemy.com  →  app on Robinhood Chain (4663)
ALCHEMY_API_KEY=
PAID_RPC_URL=
WS_URL=
SEND_RPC_URL=
RPC_TIMEOUT_S=12

PRIVATE_KEY=
DRY_RUN=true
TARGET_WALLETS=
COPY_MODE=percent
COPY_PERCENT=15
FIXED_BUY_ETH=0.02
SELL_MODE=mirror
SLIPPAGE_BPS=150
MAX_BUY_ETH=0.05
MAX_DAILY_ETH=0.25
MIN_LEADER_TRADE_ETH=0.005
MIN_LIQUIDITY_ETH=0.3
MAX_PRICE_IMPACT_BPS=800
SKIP_LAUNCH_PROTECTION=true
COOLDOWN_MS=4000
TOKEN_BLACKLIST=
HOST=127.0.0.1
PORT=8787
