{
  "name": "pons-copy-trading-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Copy-trade pons.family wallets on Robinhood Chain",
  "scripts": {
    "dev": "concurrently -n bot,web -c yellow,cyan \"npm run dev:bot\" \"npm run dev:web\"",
    "dev:bot": "tsx watch src/index.ts",
    "dev:py": "python -m bot",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "start": "tsx src/index.ts",
    "smoke": "tsx src/smoke.ts",
    "replay": "tsx src/replay.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "viem": "^2.31.7",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^24.3.1",
    "@types/express": "^5.0.3",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
